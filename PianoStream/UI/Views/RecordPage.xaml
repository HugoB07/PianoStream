<Page
    x:Class="PianoStream.UI.Views.RecordPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Unloaded="RecordPage_Unloaded">


    <Grid x:Name="RootGrid" Margin="10,20,10,10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Zone contrôles d'enregistrement -->
        <Border Grid.Row="1" 
                BorderBrush="Gray" 
                BorderThickness="1" 
                CornerRadius="8"
                Padding="10"
                Margin="0,0,0,15">
            <WrapPanel VerticalAlignment="Top" ItemHeight="58" ItemWidth="Auto" HorizontalAlignment="Left">

                <!-- Bouton Record/Stop -->
                <ui:Button Name="RecordButton"
                           Content="🔴 Start Recording"
                           MinWidth="150"
                           Height="47"
                           Margin="5"
                           Padding="10,5"
                           Click="RecordButton_Click"/>

                <!-- Nom de l'enregistrement -->
                <Border Padding="5" Margin="5" CornerRadius="6" BorderBrush="Gray" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Label Content="Name:" VerticalAlignment="Center"/>
                        <TextBox x:Name="RecordingNameTextBox" 
                                 Width="200" 
                                 Margin="5,0"
                                 VerticalAlignment="Center"
                                 Text="My Recording"/>
                    </StackPanel>
                </Border>

                <!-- SoundFont pour l'enregistrement -->
                <Border Padding="5" Margin="5" CornerRadius="6" BorderBrush="Gray" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Label Content="SoundFont:" VerticalAlignment="Center"/>
                        <ComboBox x:Name="RecordSoundFontComboBox" Width="150" Margin="5,0"/>
                    </StackPanel>
                </Border>

                <!-- Sélection du périphérique MIDI -->
                <Border Padding="5" Margin="5" CornerRadius="6" BorderBrush="Gray" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Label Content="MIDI Device:" VerticalAlignment="Center"/>
                        <ComboBox x:Name="MidiDeviceComboBox" Width="180" Margin="5,0"/>
                    </StackPanel>
                </Border>

                <!-- Statut en temps réel -->
                <Border Padding="5" Margin="5" CornerRadius="6" BorderBrush="Gray" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Label Content="Status:" VerticalAlignment="Center"/>
                        <Label x:Name="StatusLabel" Content="Ready" VerticalAlignment="Center" Foreground="Green"/>
                    </StackPanel>
                </Border>

                <!-- Temps d'enregistrement -->
                <Border Padding="5" Margin="5" CornerRadius="6" BorderBrush="Gray" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Label Content="Duration:" VerticalAlignment="Center"/>
                        <Label x:Name="DurationLabel" Content="00:00.000" VerticalAlignment="Center" FontFamily="Consolas"/>
                    </StackPanel>
                </Border>

            </WrapPanel>
        </Border>

        <!-- Zone principale avec onglets -->
        <TabControl Grid.Row="2" Margin="0,10,0,0">
            <!-- Onglet Enregistrements -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="FolderOpen24" Margin="0,0,8,0"/>
                        <ui:TextBlock Text="Recordings" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Contrôles de lecture -->
                    <ui:Card Grid.Row="0" 
                             Margin="0,0,0,15"
                             Padding="15">
                        <WrapPanel>
                            <ui:Button Name="PlayButton"
                                       Content="▶️ Play"
                                       MinWidth="80"
                                       Height="35"
                                       Margin="5"
                                       Click="PlayButton_Click"
                                       IsEnabled="False"
                                       Appearance="Success"/>

                            <ui:Button Name="StopPlayButton"
                                       Content="⏹️ Stop"
                                       MinWidth="80"
                                       Height="35"
                                       Margin="5"
                                       Click="StopPlayButton_Click"
                                       IsEnabled="False"
                                       Appearance="Danger"/>

                            <!-- SoundFont pour le playback -->
                            <Border Padding="8" Margin="10,0" VerticalAlignment="Center" CornerRadius="4" BorderBrush="LightGray" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <ui:TextBlock Text="Playback SoundFont:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="PlaybackSoundFontComboBox" 
                                              Width="150" />
                                </StackPanel>
                            </Border>

                            <Border Margin="15,0" VerticalAlignment="Center">
                                <StackPanel>
                                    <ui:TextBlock Text="Playback Progress" FontSize="11" Margin="0,0,0,3"/>
                                    <ProgressBar x:Name="PlaybackProgressBar"
                                               Width="200"
                                               Height="8"
                                               Minimum="0"
                                               Maximum="100"
                                               Value="0"/>
                                </StackPanel>
                            </Border>

                            <ui:TextBlock x:Name="PlaybackTimeLabel" 
                                          Text="00:00 / 00:00" 
                                          VerticalAlignment="Center" 
                                          FontFamily="Consolas"
                                          Margin="10,0"/>
                        </WrapPanel>
                    </ui:Card>

                    <!-- Liste des enregistrements -->
                    <ui:Card Grid.Row="1" Padding="0">
                        <DataGrid x:Name="RecordingsDataGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  SelectionMode="Single"
                                  SelectionChanged="RecordingsDataGrid_SelectionChanged"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  Background="Transparent"
                                  BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Duration" Binding="{Binding FormattedDuration}" Width="100" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Created" Binding="{Binding FormattedCreatedAt}" Width="140" IsReadOnly="True"/>
                                <DataGridTextColumn Header="SoundFont" Binding="{Binding SoundFontUsed}" Width="150" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Events" Binding="{Binding Events.Count}" Width="80" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="Actions" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:Button Width="40" 
                                                           Height="30"
                                                           Margin="2"
                                                           ToolTip="Rename Recording"
                                                           Click="RenameRecording_Click"
                                                           Tag="{Binding}"
                                                           Appearance="Primary">
                                                    <ui:SymbolIcon Symbol="Rename24"/>
                                                </ui:Button>
                                                <ui:Button Width="40" 
                                                           Height="28"
                                                           Margin="2"
                                                           ToolTip="Delete Recording"
                                                           Click="DeleteRecording_Click"
                                                           Tag="{Binding}"
                                                           Appearance="Danger">
                                                    <ui:SymbolIcon Symbol="Delete24"/>
                                                </ui:Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </ui:Card>
                </Grid>
            </TabItem>

            <!-- Onglet Export -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowExportUp24" Margin="0,0,8,0"/>
                        <ui:TextBlock Text="Export" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Sélection de l'enregistrement à exporter -->
                    <ui:Card Grid.Row="0" 
                             Margin="0,0,0,15"
                             Padding="15">
                        <StackPanel>
                            <ui:TextBlock Text="Select recording to export:" FontWeight="Medium" Margin="0,0,0,10"/>
                            <ComboBox x:Name="ExportRecordingComboBox"
                                      DisplayMemberPath="Name"
                                      SelectionChanged="ExportRecordingComboBox_SelectionChanged"
                                      MinWidth="300"/>
                        </StackPanel>
                    </ui:Card>

                    <!-- Options d'export -->
                    <ui:Card Grid.Row="1" 
                             Margin="0,0,0,15"
                             Padding="15">
                        <StackPanel>
                            <ui:TextBlock Text="Export Formats:" FontWeight="Medium" Margin="0,0,0,10"/>
                            <WrapPanel>
                                <ui:Button Name="ExportMidiButton"
                                           MinWidth="120"
                                           Height="40"
                                           Margin="5"
                                           Click="ExportMidiButton_Click"
                                           IsEnabled="False">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="MusicNote124" Margin="0,0,8,0"/>
                                        <ui:TextBlock Text="MIDI"/>
                                    </StackPanel>
                                </ui:Button>

                                <ui:Button Name="ExportWavButton"
                                           MinWidth="120"
                                           Height="40"
                                           Margin="5"
                                           Click="ExportWavButton_Click"
                                           IsEnabled="False">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Speaker224" Margin="0,0,8,0"/>
                                        <ui:TextBlock Text="WAV"/>
                                    </StackPanel>
                                </ui:Button>

                                <ui:Button Name="ExportMp3Button"
                                           MinWidth="120"
                                           Height="40"
                                           Margin="5"
                                           Click="ExportMp3Button_Click"
                                           IsEnabled="False">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Headphones24" Margin="0,0,8,0"/>
                                        <ui:TextBlock Text="MP3"/>
                                    </StackPanel>
                                </ui:Button>
                            </WrapPanel>
                        </StackPanel>
                    </ui:Card>

                    <!-- Zone de progression d'export -->
                    <ui:Card Grid.Row="2" 
                             Padding="20"
                             VerticalAlignment="Top">
                        <StackPanel>
                            <ui:TextBlock Text="Export Progress:" FontWeight="Medium" Margin="0,0,0,15"/>

                            <ProgressBar x:Name="ExportProgressBar"
                                       Height="8"
                                       Minimum="0"
                                       Maximum="100"
                                       Value="0"
                                       Margin="0,0,0,15"/>

                            <ui:TextBlock x:Name="ExportStatusLabel" 
                                          Text="Ready to export"
                                          HorizontalAlignment="Center"
                                          FontSize="14"/>
                        </StackPanel>
                    </ui:Card>
                </Grid>
            </TabItem>

        </TabControl>

    </Grid>
</Page>